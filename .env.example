# TomTom (server-only; the key must never reach the browser)
TOMTOM_API_KEY=

# Refresh cadence in seconds, clamped 60–90
REFRESH_INTERVAL_S=75

# Daily request budgets — verify against the TomTom developer portal before ship
# (pricing changed July 2026; these are config, not constants)
DAILY_TILE_BUDGET=50000
DAILY_NONTILE_BUDGET=2500
BUDGET_SOFT_PCT=60
BUDGET_HARD_PCT=80

# File-based persistence root (budget ledger, snapshots)
DATA_DIR=data
